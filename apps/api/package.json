{
  "name": "@ad-clustering/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test:input-contract": "tsx src/services/analysisInputManifest.validation.ts",
    "test:orchestrator": "tsx src/services/researchPipelineOrchestrator.validation.ts",
    "test:axis-a-adapter": "tsx src/services/axisAResultAdapter.validation.ts",
    "test:axis-b-adapter": "tsx src/services/axisBResultAdapter.validation.ts",
    "test:repository": "tsx src/services/runRepository.validation.ts",
    "start": "tsx src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
